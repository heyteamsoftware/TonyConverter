# El cuerpo de la petición se lee directamente desde la conexión: PHP no lo
# copia a un archivo temporal en disco.
<IfModule mod_php.c>
  php_flag enable_post_data_reading Off
  php_value post_max_size 51M
  php_value max_execution_time 180
</IfModule>

# Solo se puede usar el conversor
<FilesMatch "^(?!convert\.php$).*$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always unset Cache-Control
  Header always set Cache-Control "no-store"
</IfModule>
