#!/bin/bash
# Gallardito Converter: convierte /dev/shm/gallardito/<id>/in.docx con LibreOffice.
# Se ejecuta como lo-convert (sin red). Usa el perfil temporal que prepara
# convert.php en <id>/profile y lo borra al terminar.
set -euo pipefail
JOB="${1:-}"; FMT="${2:-}"
[[ "$JOB" =~ ^/dev/shm/gallardito/[a-f0-9]{32}$ ]] || exit 2
[[ -d "$JOB" && ! -L "$JOB" && -f "$JOB/in.docx" && ! -L "$JOB/in.docx" ]] || exit 2
case "$FMT" in
  pdf) FILTER='pdf:writer_pdf_Export' ;;
  rtf) FILTER='rtf:Rich Text Format' ;;
  *) exit 2 ;;
esac
PROFILE="$JOB/profile"
trap 'rm -rf "$PROFILE"' EXIT
umask 0002
mkdir -p "$PROFILE/tmp"
export HOME="$PROFILE" TMPDIR="$PROFILE/tmp" LANG=es_ES.UTF-8 PATH=/usr/bin:/bin
cd "$PROFILE"
timeout -k 5 90 /usr/bin/soffice "-env:UserInstallation=file://$PROFILE" \
  --headless --invisible --norestore --nolockcheck --nodefault --nologo \
  --convert-to "$FILTER" --outdir "$JOB/out" "$JOB/in.docx" >/dev/null 2>&1
